#!/usr/bin/env bash
# Read-only Konnect access for kuma-migrator.
# Generated by kuma-migrator {{.GeneratedBy}}: kuma-migrator konnect token-script
#
# Run by a Konnect organization admin. It creates a system account, grants it
# read-only access, and prints one access token that expires on {{.ExpiresAtRFC3339}}.
# Give that token to whoever runs kuma-migrator extract. Nothing else is shared.
#
#   Region:   {{.Region}}
{{- if .ScopeMesh}}
#   Access:   "Viewer" role on {{if .ControlPlanes}}these Mesh control planes: {{.CPList}}{{else}}every Mesh control plane in the region{{end}}
{{- else}}
#   Access:   member of the "Organization Admin (Read Only)" team (read access to the whole organization)
{{- end}}
#   Account:  {{.AccountName}}
#
# Requirements: bash, curl, jq, and an organization admin personal access token
# in KONNECT_ADMIN_PAT. The admin token is only sent to *.api.konghq.com and is
# never printed.
#
#   KONNECT_ADMIN_PAT=kpat_... bash ./konnect-readonly-token.sh
set -euo pipefail

REGION="{{.Region}}"
ACCOUNT_NAME="{{.AccountName}}"
EXPIRES_AT="{{.ExpiresAtRFC3339}}"
{{- if .ScopeMesh}}
CONTROL_PLANES="{{.CPList}}" # empty: every Mesh control plane in the region
{{- end}}

GLOBAL_API="https://global.api.konghq.com"
REGION_API="https://${REGION}.api.konghq.com"

: "${KONNECT_ADMIN_PAT:?set KONNECT_ADMIN_PAT to an organization admin personal access token}"
for bin in curl jq; do
  command -v "$bin" >/dev/null || { echo "missing dependency: $bin" >&2; exit 1; }
done

# api METHOD URL [JSON_BODY]: prints the response body, exits on an HTTP error.
api() {
  local method=$1 url=$2 body=${3:-} out status
  out=$(mktemp)
  status=$(curl -sS -o "$out" -w '%{http_code}' -X "$method" "$url" \
    -H "Authorization: Bearer ${KONNECT_ADMIN_PAT}" \
    -H "Content-Type: application/json" \
    ${body:+--data "$body"})
  if [ "$status" -ge 400 ]; then
    echo "error: $method $url returned HTTP $status" >&2
    cat "$out" >&2; echo >&2
    rm -f "$out"
    return 1
  fi
  cat "$out"; rm -f "$out"
}

# 1. System account (reused when one with this name already exists)
SA_ID=$(api GET "${GLOBAL_API}/v3/system-accounts?filter%5Bname%5D%5Beq%5D=${ACCOUNT_NAME}" | jq -r '.data[0].id // empty')
if [ -z "$SA_ID" ]; then
  SA_ID=$(api POST "${GLOBAL_API}/v3/system-accounts" "$(jq -nc --arg n "$ACCOUNT_NAME" \
    '{name: $n, description: "Read-only access for kuma-migrator extract", konnect_managed: false}')" | jq -r '.id')
  echo "Created system account ${ACCOUNT_NAME} (${SA_ID})"
else
  echo "Reusing system account ${ACCOUNT_NAME} (${SA_ID})"
fi
{{- if .ScopeMesh}}

# 2. "Viewer" role on each Mesh control plane
CPS=$(api GET "${REGION_API}/v1/mesh/control-planes?page%5Bsize%5D=100" | jq -c '[.data[] | {id, name}]')
if [ -n "$CONTROL_PLANES" ]; then
  for want in $CONTROL_PLANES; do
    echo "$CPS" | jq -e --arg n "$want" 'any(.[]; .name == $n)' >/dev/null \
      || { echo "error: no Mesh control plane named ${want} in region ${REGION}" >&2; exit 1; }
  done
  CPS=$(echo "$CPS" | jq -c --arg l "$CONTROL_PLANES" '($l | split(" ")) as $w | [.[] | select(.name as $n | $w | index($n))]')
fi
[ "$(echo "$CPS" | jq length)" -gt 0 ] || { echo "error: no Mesh control plane found in region ${REGION}" >&2; exit 1; }

echo "$CPS" | jq -r '.[] | "\(.id) \(.name)"' | while read -r cp_id cp_name; do
  if api POST "${GLOBAL_API}/v3/system-accounts/${SA_ID}/assigned-roles" "$(jq -nc --arg id "$cp_id" --arg r "$REGION" \
      '{role_name: "Viewer", entity_type_name: "Mesh Control Planes", entity_id: $id, entity_region: $r}')" >/dev/null 2>&1; then
    echo "Granted Viewer on ${cp_name}"
  else
    echo "Viewer on ${cp_name}: not granted (already assigned, or check the admin token's permissions)"
  fi
done
{{- else}}

# 2. Membership of the predefined read-only team
TEAM_ID=$(api GET "${GLOBAL_API}/v3/teams?page%5Bsize%5D=100" \
  | jq -r '.data[] | select(.name == "organization-admin-readonly" or .name == "Organization Admin (Read Only)") | .id' | head -1)
[ -n "$TEAM_ID" ] || { echo "error: predefined team Organization Admin (Read Only) not found" >&2; exit 1; }
if api POST "${GLOBAL_API}/v3/teams/${TEAM_ID}/system-accounts" "$(jq -nc --arg id "$SA_ID" '{id: $id}')" >/dev/null 2>&1; then
  echo "Added to Organization Admin (Read Only)"
else
  echo "Organization Admin (Read Only): not added (already a member, or check the admin token's permissions)"
fi
{{- end}}

# 3. Access token. Konnect shows its value once.
TOKEN=$(api POST "${GLOBAL_API}/v3/system-accounts/${SA_ID}/access-tokens" "$(jq -nc \
  --arg n "kuma-migrator-$(date -u +%Y%m%dT%H%M%SZ)" --arg e "$EXPIRES_AT" '{name: $n, expires_at: $e}')" | jq -r '.token')
[ "${#TOKEN}" -gt 20 ] || { echo "error: Konnect returned no token" >&2; exit 1; }

cat <<EOF

Token for kuma-migrator (shown once, expires ${EXPIRES_AT}):

  ${TOKEN}

Send it over a channel you trust. To use it, run for each Mesh control plane:

EOF
{{- if .ScopeMesh}}
echo "$CPS" | jq -r --arg r "$REGION" '.[] | "  kumactl config control-planes add --name konnect-\(.name) \\\n    --address https://\($r).api.konghq.com/v1/mesh/control-planes/\(.id)/api \\\n    --headers \"authorization=Bearer $KONNECT_RO_TOKEN\"\n  kuma-migrator extract --kumactl-context konnect-\(.name) --output-dir ./raw-policies\n"'
{{- else}}
api GET "${REGION_API}/v1/mesh/control-planes?page%5Bsize%5D=100" | jq -r --arg r "$REGION" '.data[] | "  kumactl config control-planes add --name konnect-\(.name) \\\n    --address https://\($r).api.konghq.com/v1/mesh/control-planes/\(.id)/api \\\n    --headers \"authorization=Bearer $KONNECT_RO_TOKEN\"\n  kuma-migrator extract --kumactl-context konnect-\(.name) --output-dir ./raw-policies\n"'
{{- end}}
cat <<EOF
with KONNECT_RO_TOKEN set to the token above.

To revoke access, delete the system account:

  curl -X DELETE ${GLOBAL_API}/v3/system-accounts/${SA_ID} -H "Authorization: Bearer \$KONNECT_ADMIN_PAT"
EOF
